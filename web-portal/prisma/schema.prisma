generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Enable pgvector extension
// This will be added via raw SQL in migration

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum UserRole {
  USER
  ADMIN
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  REMOTE
}

enum JobStatus {
  ACTIVE
  CLOSED
  DRAFT
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  name          String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  resumes       Resume[]
  
  @@index([email])
}

model Resume {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName          String
  originalName      String
  fileSize          Int
  mimeType          String
  minioPath         String
  processingStatus  ProcessingStatus @default(PENDING)
  skills            Json?     // Stores extracted skills as JSON
  embedding         Unsupported("vector(1536)")? // pgvector embedding
  experience        Json?     // Stores extracted experience as JSON
  education         Json?     // Stores extracted education as JSON
  processedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  recommendations   CareerRecommendation[]
  
  @@index([userId])
  @@index([processingStatus])
}

model CareerRecommendation {
  id             String   @id @default(uuid())
  resumeId       String
  resume         Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  jobTitle       String
  company        String?
  matchScore     Float
  skillsMatched  String[] // Array of matched skills
  description    String
  careerPath     String?  // RAG-based career path
  category       String?  // Career category
  createdAt      DateTime @default(now())
  
  @@index([resumeId])
  @@index([matchScore])
}

model CareerPath {
  id             String   @id @default(uuid())
  title          String   @unique
  category       String
  description    String
  requiredSkills String[]
  softSkills     String[] @default([])
  roadmap        Json?
  averageSalary  String
  jobOpenings    Int      @default(0)
  growthRate     Float    @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  jobs           Job[]

  @@index([category])
  @@index([active])
}

model Job {
  id              String    @id @default(uuid())
  title           String
  company         String
  location        String
  type            JobType    @default(FULL_TIME)
  status          JobStatus  @default(ACTIVE)
  description     String
  requirements    String[]
  salary          String?
  salaryRange     String?
  experienceLevel String?
  careerPathId    String?
  careerPath      CareerPath? @relation(fields: [careerPathId], references: [id], onDelete: SetNull)
  postedAt        DateTime   @default(now())
  expiresAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([status])
  @@index([careerPathId])
  @@index([type])
}
