generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Enable pgvector extension
// This will be added via raw SQL in migration

enum ProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum UserRole {
  USER
  ADMIN
  MODERATOR
  RECRUITER
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  REMOTE
}

enum JobStatus {
  ACTIVE
  CLOSED
  DRAFT
}

enum AIProvider {
  OPENAI
  ANTHROPIC
  GOOGLE
  CUSTOM
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  name          String?
  role          UserRole  @default(USER)
  phoneNumbers  String[]  @default([])
  avatar        String?
  bio           String?
  location      String?
  website       String?
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  resumes       Resume[]
  bookmarks     JobBookmark[]
  notifications  Notification[]
  activityLogs  ActivityLog[]
  auditLogs     AuditLog[]
  feedbacks     Feedback[]
  
  @@index([email])
}

model Resume {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName          String
  originalName      String
  fileSize          Int
  mimeType          String
  minioPath         String
  processingStatus  ProcessingStatus @default(PENDING)
  skills            Json?     // Stores extracted skills as JSON
  embedding         Unsupported("vector(1536)")? // pgvector embedding
  experience        Json?     // Stores extracted experience as JSON
  education         Json?     // Stores extracted education as JSON
  processedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  recommendations   CareerRecommendation[]
  
  @@index([userId])
  @@index([processingStatus])
}

model CareerRecommendation {
  id             String   @id @default(uuid())
  resumeId       String
  resume         Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  jobTitle       String
  company        String?
  matchScore     Float
  skillsMatched  String[] // Array of matched skills
  description    String
  careerPath     String?  // RAG-based career path
  category       String?  // Career category
  createdAt      DateTime @default(now())
  
  @@index([resumeId])
  @@index([matchScore])
}

model CareerPath {
  id             String   @id @default(uuid())
  title          String   @unique
  category       String
  description    String
  requiredSkills String[]
  softSkills     String[] @default([])
  roadmap        Json?
  averageSalary  String
  jobOpenings    Int      @default(0)
  growthRate     Float    @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  jobs           Job[]

  @@index([category])
  @@index([active])
}

model Job {
  id              String    @id @default(uuid())
  title           String
  company         String
  location        String
  type            JobType    @default(FULL_TIME)
  status          JobStatus  @default(ACTIVE)
  description     String
  requirements    String[]
  salary          String?
  salaryRange     String?
  experienceLevel String?
  phoneNumbers    String[]   @default([])
  emails          String[]   @default([])
  careerPathId    String?
  careerPath      CareerPath? @relation(fields: [careerPathId], references: [id], onDelete: SetNull)
  postedAt        DateTime   @default(now())
  expiresAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  bookmarks       JobBookmark[]

  @@index([status])
  @@index([careerPathId])
  @@index([type])
}

model JobBookmark {
  id        String   @id @default(uuid())
  userId    String
  jobId     String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // JOB_MATCH, RESUME_PROCESSED, SYSTEM
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
}

model ActivityLog {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      String   // LOGIN, LOGOUT, UPLOAD_RESUME, BOOKMARK_JOB, VIEW_JOB, UPDATE_PROFILE
  entityType  String?  // RESUME, JOB, PROFILE
  entityId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model AuditLog {
  id          String   @id @default(uuid())
  adminId     String
  admin       User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action      String   // CREATE_USER, DELETE_USER, UPDATE_USER_STATUS, DELETE_RESUME, UPDATE_CAREER_PATH, DELETE_JOB
  entityType  String?  // USER, RESUME, CAREER_PATH, JOB, SKILL
  entityId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

model Feedback {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // BUG_REPORT, FEATURE_REQUEST, COMPLAINT, SUGGESTION
  subject     String
  message     String
  status      String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  priority    String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  adminNotes  String?
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Skill {
  id          String   @id @default(uuid())
  name        String   @unique
  category    String   // TECHNICAL, SOFT, LANGUAGE, TOOL
  description String?
  difficulty  String   @default("INTERMEDIATE") // BEGINNER, INTERMEDIATE, ADVANCED, EXPERT
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([active])
}

model SystemConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  category    String   // AI, RATE_LIMIT, GENERAL, NOTIFICATION
  updatedAt   DateTime @updatedAt

  @@index([category])
}

model EmailConfig {
  id          String   @id @default(uuid())
  provider    String   @default("SMTP") // SMTP, SENDGRID, MAILGUN, AWS_SES
  host        String?
  port        Int?
  username    String?
  password    String?
  fromEmail   String?
  fromName    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ApiKey {
  id          String      @id @default(uuid())
  provider    AIProvider
  modelName   String
  apiKey      String
  limit       Int         @default(0) // 0 means unlimited
  used        Int         @default(0)
  expiresAt   DateTime?
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([provider])
  @@index([active])
}
